android_app {
    name: "SoftApStatusDemo",
    
    srcs: ["src/**/*.java"],
    
    resource_dirs: ["res"],
    
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    
    libs: [
        "framework-wifi.stubs.system",
    ],

    static_libs: [
        "qtiwifi_manager",
    ],
    
    optimize: {
        enabled: false,
    },
    
    dex_preopt: {
        enabled: false,
    },
}
